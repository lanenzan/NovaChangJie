    msbuild src\settings-ui\NovaChangJieSettingsUI.vcxproj -t:restore -p:RestorePackagesConfig=true
    msbuild src\settings-ui\NovaChangJieSettingsUI.vcxproj -p:Configuration=Release -p:Platform=x64

