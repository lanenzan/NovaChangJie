<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NovaSettings.UserWordsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NovaSettings">

    <Grid x:Name="Root" Language="zh-Hant-TW">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="Save_Accelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="Undo_Accelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="Add_Accelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Find_Accelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar (drag area). -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="NovaChangJie 使用者造詞工具" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Commands and search. -->
        <Grid Grid.Row="1" Padding="12,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar x:Name="Commands" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="AddButton" Label="新增" Click="Add_Click" ToolTipService.ToolTip="新增詞彙 (Ctrl+N)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Label="修改" Click="Edit_Click" ToolTipService.ToolTip="修改選取的詞彙 (Enter)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="刪除" Click="Delete_Click" ToolTipService.ToolTip="刪除選取的詞彙 (Delete)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="UndoButton" Label="復原刪除" Click="Undo_Click" ToolTipService.ToolTip="復原刪除 (Ctrl+Z)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="MoveButton" Label="移至使用者造詞" Click="Move_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="SaveButton" Label="儲存" Click="Save_Click" ToolTipService.ToolTip="儲存變更 (Ctrl+S)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="ImportButton" Label="匯入…" Click="Import_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="ExportButton" Label="匯出…" Click="Export_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="依詞彙排序" Tag="Phrase" Click="Sort_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="依字根排序" Tag="Reading" Click="Sort_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="SortShortcutButton" Label="依捷徑排序" Tag="Shortcut" Click="Sort_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                            PlaceholderText="搜尋詞彙或捷徑" QueryIcon="Find" TextChanged="Search_TextChanged" />
        </Grid>

        <!-- 使用者造詞 / 常用新詞 -->
        <SelectorBar x:Name="Views" Grid.Row="2" Margin="12,4,0,0" SelectionChanged="Views_SelectionChanged">
            <SelectorBarItem x:Name="UserViewItem" Text="使用者造詞" IsSelected="True" />
            <SelectorBarItem x:Name="LearnedViewItem" Text="常用新詞" />
        </SelectorBar>

        <!-- Column headers. -->
        <Grid Grid.Row="3" Margin="16,8,16,0" Padding="16,0,16,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="#" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="WordHeader" Grid.Column="1" Text="詞彙" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="字根" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ExtraHeader" Grid.Column="3" Text="捷徑" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- The words. -->
        <Grid Grid.Row="4" Margin="16,0,16,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="{ThemeResource OverlayCornerRadius}">
            <ListView x:Name="Words" SelectionMode="Extended" IsDoubleTapEnabled="True"
                      DoubleTapped="Words_DoubleTapped" SelectionChanged="Words_SelectionChanged" KeyDown="Words_KeyDown">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WordItem">
                        <Grid ColumnSpacing="12" Padding="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Number}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Radicals}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Extra}" FontFamily="Consolas" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE8C4;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Status line. -->
        <Grid Grid.Row="5" Padding="20,8,20,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <InfoBar x:Name="Status" Grid.Column="1" IsOpen="False" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
