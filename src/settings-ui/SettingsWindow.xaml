<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NovaSettings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Language="zh-Hant-TW">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag area). -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="NovaChangJie 星倉頡 設定" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="一般" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="輸入" Tag="Input">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="候選字視窗" Tag="Candidates">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="辭典與學習" Tag="Dictionary">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="關於" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Padding lives on the inner Grid, not the ScrollViewer: a padded
                 ScrollViewer misplaces MaxWidth content and clips its right edge
                 when the window is wide. Content stays left-aligned, as in
                 Windows Settings. -->
            <ScrollViewer x:Name="Scroller">
                <Grid Padding="40,0,40,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1000" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Padding="0,8,0,40" Spacing="4">
                    <TextBlock x:Name="PageTitle" Text="一般" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

                    <!-- 一般 -->
                    <StackPanel x:Name="GeneralPage" Spacing="4">
                        <TextBlock Text="輸入模式" Style="{StaticResource SectionHeaderStyle}" Margin="1,0,0,6" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D3;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="預設輸入模式" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="應用程式開啟時，輸入法的預設輸入模式。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="StartMode" Grid.Column="2" Style="{StaticResource CardComboStyle}">
                                <x:String>中文模式</x:String>
                                <x:String>英文模式</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8AB;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="按 Shift 切換中／英" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="單獨按一下 Shift 鍵，在中文和英文模式之間切換。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShiftToggles" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE740;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="預設全形" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="以 Shift+Space 切換全形／半形。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartFullShape" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D2;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="預設中文標點" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="以 Ctrl+. 切換中文／英文標點。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ChinesePunctuation" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>

                        <TextBlock Text="輸出" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8C1;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="字元集" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="選擇可輸出的字元 (請確定已經安裝所需字型)。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="CharsetBox" Grid.Column="2" Style="{StaticResource CardComboStyle}">
                                <x:String>Unicode 字元 (全部)</x:String>
                                <x:String>Big5 + 香港增補字符集</x:String>
                                <x:String>Big5 字元</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8C8;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="輸出簡體中文" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="以倉頡輸入，送出簡體字。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="OutputSimplified" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- 輸入 -->
                    <StackPanel x:Name="InputPage" Spacing="4" Visibility="Collapsed">
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BE;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="倉頡版本" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="選擇倉頡字根的版本；三五代混打可同時使用兩代字碼。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="VersionBox" Grid.Column="2" Style="{StaticResource CardComboStyle}">
                                <x:String>倉頡第五代</x:String>
                                <x:String>倉頡第三代</x:String>
                                <x:String>三五代混打</x:String>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="選字" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE945;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="智慧選字" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="整句輸入，依上下文自動選字，按 Enter 送出。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SentenceMode" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource SubCardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="輸入字根時亦顯示候選字" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="CodeCandidates" Grid.Column="1" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="預測" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="列出字根開頭相同的常用字。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="Prediction" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource SubCardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="在預測字旁顯示其餘字根" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ShowCodeHints" Grid.Column="1" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8E3;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="提示相關字詞" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="送出文字後列出常接著出現的詞語 (以 Shift+數字選取)。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="Association" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>

                        <TextBlock Text="自動送出" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="只有一個候選字時自動上字" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoCommitUnique" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE76C;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="輸入第六個字根時自動送出首選字" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoCommitOnOverflow" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="多功能前導字元鍵提示" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="按 ` 鍵時列出可用功能：U Unicode、B Big5、P 捷徑、全形標點。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PrefixHints" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- 候選字視窗 -->
                    <StackPanel x:Name="CandidatesPage" Spacing="4" Visibility="Collapsed">
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8C0;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="排列方式" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LayoutBox" Grid.Column="2" Style="{StaticResource CardComboStyle}">
                                <x:String>直式</x:String>
                                <x:String>橫式</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FD;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="每頁字數" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="PageSizeBox" Grid.Column="2" Style="{StaticResource CardComboStyle}">
                                <x:String>5</x:String>
                                <x:String>6</x:String>
                                <x:String>7</x:String>
                                <x:String>8</x:String>
                                <x:String>9</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8E9;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="字型大小" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="候選字視窗的字型大小 (點)。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="FontSizeBox" Grid.Column="2" Style="{StaticResource CardComboStyle}">
                                <x:String>14</x:String>
                                <x:String>16</x:String>
                                <x:String>18</x:String>
                                <x:String>20</x:String>
                                <x:String>22</x:String>
                                <x:String>24</x:String>
                                <x:String>28</x:String>
                                <x:String>32</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D2;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="以英文字母顯示字根" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="例如顯示 oiar，而不是 人戈口。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowLetters" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- 辭典與學習 -->
                    <StackPanel x:Name="DictionaryPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="個人化調整" Style="{StaticResource SectionHeaderStyle}" Margin="1,0,0,6" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE81C;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="記住最近用過的字詞" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="常用的字詞和詞語組合排在前面。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="Learning" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource SubCardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="候選字順序" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="OrderBox" Grid.Column="1" Style="{StaticResource CardComboStyle}">
                                <x:String>依使用頻率調整</x:String>
                                <x:String>固定 (傳統 Big5 次序)</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SubCardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="清除學習記錄" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="刪除所有學到的字詞，候選字回復預設次序。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="清除" VerticalAlignment="Center" Click="ClearHistory_Click" />
                        </Grid>

                        <TextBlock Text="智慧選字語言模型" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71B;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="依前後詞語的接續機率選字" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="以詞語接續模型判斷哪些詞語常連在一起。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WordPairs" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE99A;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="以神經網路語言模型再次比對" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="由背景程式 NovaChangJieLM 讀整句再選一次，對速成特別有幫助。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NeuralRerank" Grid.Column="2" Style="{StaticResource CardToggleStyle}" />
                        </Grid>

                        <TextBlock Text="使用者造詞" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="使用者造詞工具" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="新增或修改自建詞彙和捷徑，管理從輸入學到的常用新詞。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="開啟" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                    Click="OpenUserWords_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- 關於 -->
                    <StackPanel x:Name="AboutPage" Spacing="4" Visibility="Collapsed">
                        <Grid Style="{StaticResource CardStyle}" Padding="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="48" Height="48" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="NovaChangJie 星倉頡 / Nova Quick 星速成" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource CardDescriptionStyle}" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Margin="0,8,0,0"
                                           Text="以 Text Services Framework 從頭編寫的倉頡輸入法，重現微軟新倉頡的功能。" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}"
                                           Text="NovaChangJie 是獨立項目，與 Microsoft 無關。以 CC BY-NC-SA 4.0 授權發佈：可自由使用、修改及分享，但須註明出處、不得作商業用途，修改後的作品須以相同授權發佈。" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="授權與資料來源" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="授權條款" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="NovaChangJie 的 CC BY-NC-SA 4.0 授權（非商業、相同方式分享）。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="檢視" Tag="LICENSE.txt" Click="OpenDoc_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="字碼與詞庫來源" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="libcangjie (公有領域)、rime-essay (LGPL-3.0)。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="檢視" Tag="DATA-LICENSES.md" Click="OpenDoc_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8C8;" Style="{StaticResource CardIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="語言模型訓練文字" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Common Voice、HKCanCor、Tatoeba、rime-cantonese、台灣及香港法規。" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="檢視" Tag="TEXT-SOURCES.md" Click="OpenDoc_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <InfoBar x:Name="Status" IsOpen="False" Margin="0,12,0,0" />
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
